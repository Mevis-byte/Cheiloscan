# CheiloScan configuration
# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# In production, prefer real environment variables / container secrets over
# a file on disk.

# Environment mode: "development" or "production".
# development enables Flask DEBUG and permits an ephemeral secret key.
# production disables DEBUG and REQUIRES a secret key and Basic auth.
CHEILOSCAN_ENV=development

# Root directory for all local data (database, image store, reports).
# Paths are resolved relative to the working directory if not absolute.
# In Docker this is normally /data (mount a persistent volume there).
CHEILOSCAN_DATA_DIR=./data

# SQLite database URL. Leave unset to use the default location
# <CHEILOSCAN_DATA_DIR>/db/app.sqlite.
# CHEILOSCAN_DATABASE_URL=sqlite:///absolute/path/to/app.sqlite

# Secret key used by Flask. In production this MUST be at least 32 characters
# of random data, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
CHEILOSCAN_SECRET_KEY=

# --- Production access control -------------------------------------------------
# All routes except /api/health/live require HTTP Basic credentials in
# production. Generate the hash with `python -m app.security hash-password`.
CHEILOSCAN_AUTH_USERNAME=
CHEILOSCAN_AUTH_PASSWORD_HASH=
# Failed-log-in throttle (per application process; resets on restart).
CHEILOSCAN_AUTH_MAX_FAILURES=10
CHEILOSCAN_AUTH_LOCKOUT_SECONDS=60

# Reverse proxy / TLS settings. Production REQUIRES all three values below:
# terminate TLS at a trusted reverse proxy that sets X-Forwarded-* headers.
# FORCE_HTTPS redirects plain HTTP to HTTPS. ALLOWED_HOSTS is a comma-separated
# list of public hostnames (no scheme), e.g. research.example.org.
CHEILOSCAN_BEHIND_PROXY=0
CHEILOSCAN_TRUSTED_PROXY_COUNT=1
CHEILOSCAN_FORCE_HTTPS=0
CHEILOSCAN_ALLOWED_HOSTS=

# Server binding. Keep 127.0.0.1 for local-only use; use 0.0.0.0 inside a
# container behind a reverse proxy. THREADS is the Waitress worker count in
# the single application process (SQLite allows only one writer process).
CHEILOSCAN_HOST=127.0.0.1
CHEILOSCAN_PORT=5000
CHEILOSCAN_THREADS=2

# Maximum accepted upload size (request body), in megabytes.
CHEILOSCAN_MAX_UPLOAD_MB=25

# Absolute image dimension limits, in pixels. Images whose shorter side is
# below MIN or whose longer side is above MAX are rejected at intake.
# MAX_IMAGE_PIXELS caps total decoded pixels (memory safety): 20 MP ≈ 60 MB
# per working image with OpenCV's 3-channel BGR representation.
CHEILOSCAN_MIN_IMAGE_DIMENSION=128
CHEILOSCAN_MAX_IMAGE_DIMENSION=12000
CHEILOSCAN_MAX_IMAGE_PIXELS=20000000

# Experimental quality thresholds. These produce *warnings* on upload; they
# never reject an image automatically. Tune them for your capture setup and
# record any change in docs/DEVELOPMENT_LOG.md.
#   - recommended minimum side (px) for fine groove detail
#   - Laplacian variance below which an image is flagged as possibly blurry
#   - acceptable mean brightness range (0-255)
#   - minimum grayscale standard deviation (contrast)
#   - maximum fraction of pixels clipped at pure black/white
CHEILOSCAN_QUALITY_RECOMMENDED_MIN_DIMENSION=400
CHEILOSCAN_QUALITY_MIN_BLUR_VARIANCE=60
CHEILOSCAN_QUALITY_MIN_BRIGHTNESS=40
CHEILOSCAN_QUALITY_MAX_BRIGHTNESS=215
CHEILOSCAN_QUALITY_MIN_CONTRAST=25
CHEILOSCAN_QUALITY_MAX_CLIPPED_FRACTION=0.02

# Logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
CHEILOSCAN_LOG_LEVEL=INFO

# Logging format: "json" (structured, one JSON object per line) or "plain".
CHEILOSCAN_LOG_FORMAT=json

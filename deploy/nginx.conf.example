# Example TLS-terminating reverse proxy for CheiloScan.
#
# Copy to your nginx configuration, replace certificate paths and hostname,
# and keep the application bound to 127.0.0.1:8000 (or an internal Docker
# network). The app trusts exactly one proxy hop; these directives OVERWRITE
# client-supplied X-Forwarded-* headers instead of appending to them.

server {
    listen 80;
    server_name research.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name research.example.org;

    ssl_certificate     /etc/ssl/certs/cheiloscan.crt;
    ssl_certificate_key /etc/ssl/private/cheiloscan.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The app also sends HSTS on requests it sees as secure; repeat here so
    # the first redirect response is covered too.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Allow for the 25 MB default upload plus multipart overhead. Raise this
    # if CHEILOSCAN_MAX_UPLOAD_MB is increased.
    client_max_body_size 26m;

    # Synchronous preprocessing can exceed nginx's default 60 s read timeout.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Do not leak nginx/proxy details through the app's error envelope.
        proxy_hide_header X-Powered-By;
    }
}
